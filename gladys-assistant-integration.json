          "type": "string",
          "label": {
            "en": "Where to apply",
            "fr": "Où faire la demande",
            "de": "Wo beantragen",
            "es": "Dónde solicitar"
          }
        }
      ]
    }
  ],
  "scene_actions": [
    {
      "key": "read_declarations",
      "label": {
        "en": "FEMA: read the declarations",
        "fr": "FEMA : lire les déclarations",
        "de": "FEMA: Erklärungen lesen",
        "es": "FEMA: leer las declaraciones"
      },
      "description": {
        "en": "The active declarations of your counties as one sentence, to send by message or read aloud.",
        "fr": "Les déclarations en cours de vos comtés en une phrase, à envoyer par message ou à lire à voix haute.",
        "de": "Die laufenden Erklärungen deiner Countys als ein Satz, zum Senden per Nachricht oder zum Vorlesen.",
        "es": "Las declaraciones en curso de sus condados en una frase, para enviar por mensaje o leer en voz alta."
      },
      "timeout_seconds": 60,
      "outputs": [
        {
          "key": "text",
          "type": "string",
          "label": {
            "en": "Declarations, in one sentence",
            "fr": "Déclarations, en une phrase",
            "de": "Erklärungen, in einem Satz",
            "es": "Declaraciones, en una frase"
          }
        },
        {
          "key": "active_count",
          "type": "number",
          "label": {
            "en": "Active declarations",
            "fr": "Déclarations en cours",
            "de": "Laufende Erklärungen",
            "es": "Declaraciones en curso"
          }
        },
        {
          "key": "assistance_open",
          "type": "boolean",
          "label": {
            "en": "Individual Assistance open",
            "fr": "Aide aux particuliers ouverte",
            "de": "Hilfe für Privatpersonen offen",
            "es": "Asistencia individual abierta"
          }
        }
      ]
    }
  ],
  "widgets": [
    {
      "key": "declarations",
      "label": {
        "en": "FEMA declarations",
        "fr": "Déclarations FEMA",
        "de": "FEMA-Erklärungen",
        "es": "Declaraciones FEMA"
      },
      "description": {
        "en": "Active disaster declarations and open aid of your counties.",
        "fr": "Déclarations de catastrophe en cours et aides ouvertes de vos comtés.",
        "de": "Laufende Katastrophenerklärungen und offene Hilfen deiner Countys.",
        "es": "Declaraciones de desastre en curso y ayudas abiertas de sus condados."
      },
      "icon": "alert-triangle",
      "settings": [
        {
          "key": "show_link",
          "type": "boolean",
          "label": {
            "en": "Show the link to FEMA",
            "fr": "Afficher le lien vers la FEMA",
            "de": "Link zur FEMA anzeigen",
            "es": "Mostrar el enlace a FEMA"
          },
          "required": false,
          "default": true
        }
      ]
    }
